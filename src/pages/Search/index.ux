  flex: 1;
  flex-direction: column;
  justify-content: center;
  margin-left: 8px;
  margin-right: 8px;
}

.song-name {
  font-size: 14px;
  color: #ffffff;
  margin-bottom: 2px;
}

.song-artist {
  font-size: 11px;
  color: #888888;
}

