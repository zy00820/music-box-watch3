<template>
  <div class="container">
    <!-- 顶部栏 -->
    <div class="header">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">‹</text>
      </div>
      <text class="header-title">播放列表</text>
      <div class="header-right">
        <text class="count-text">{{ playlist.length }}首</text>
      </div>
    </div>

    <!-- 播放控制栏 -->
    <div class="action-bar" if="{{ playlist.length > 0 }}">
      <div class="action-btn" onclick="playAll">
        <text class="action-icon">▶</text>
        <text class="action-text">播放全部</text>
      </div>
      <div class="action-btn" onclick="clearAll">
        <text class="action-icon">🗑</text>
        <text class="action-text">清空</text>
      </div>
    </div>

    <!-- 列表 -->
    <div class="list-area" if="{{ playlist.length > 0 }}">
      <list class="list-container">
        <list-item type="song" for="{{ playlist }}" onclick="playItem($idx)">
          <div class="song-item {{ $idx === currentIndex ? 'song-active' : '' }}">
            <div class="song-index">
              <text class="index-text">{{ $idx === currentIndex && isPlaying ? '♪' : ($idx + 1) }}</text>
            </div>
            <div class="song-detail">
              <text class="song-name text-ellipsis {{ $idx === currentIndex ? 'name-active' : '' }}">{{ $item.name }}</text>
              <text class="song-artist text-ellipsis">{{ getArtistText($item) }}</text>
            </div>
            <div class="song-del" onclick="removeItem($idx, $event)">
              <text class="del-icon">✕</text>
            </div>
          </div>
        </list-item>
      </list>
    </div>

    <!-- 空状态 -->
    <div class="empty-state" if="{{ playlist.length === 0 }}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">播放列表为空</text>
      <text class="empty-hint">去搜索添加喜欢的歌曲吧</text>
      <div class="go-search-btn" onclick="goSearch">
        <text class="go-search-text">去搜索</text>
      </div>
    </div>

    <!-- Toast -->
    <div class="toast" if="{{ showToast }}">
      <text class="toast-text">{{ toastMsg }}</text>
    </div>
  </div>
</template>

<style>
