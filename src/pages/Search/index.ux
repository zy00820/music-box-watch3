  width: 32px;
  height: 32px;
  border-radius: 16px;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 77, 111, 0.15);
}

.action-icon {
  font-size: 18px;
  color: #ff4d6f;
  font-weight: 500;
}

.play-all {
  width: 100%;
  height: 48px;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 77, 111, 0.1);
}

.play-all-text {
  font-size: 14px;
  color: #ff4d6f;
  font-weight: 500;
}

/* 推荐区 */
.recommend-area {
  flex: 1;
  width: 100%;
  padding: 16px;
}

.recommend-title {
  font-size: 14px;
  color: #888888;
  margin-bottom: 12px;
}

.tags {
  flex-direction: row;
  flex-wrap: wrap;
}

.tag {
  padding-left: 14px;
  padding-right: 14px;
  padding-top: 8px;
  padding-bottom: 8px;
  background-color: #1a1a24;
  border-radius: 16px;
  margin-right: 8px;
  margin-bottom: 8px;
}

.tag-text {
  font-size: 13px;
  color: #cccccc;
}

/* 加载/空状态 */
.loading-state, .empty-state {
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.loading-text {
  font-size: 14px;
  color: #888888;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 14px;
  color: #666666;
}

/* Toast */
.toast {
  position: fixed;
  bottom: 100px;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.8);
  padding-left: 16px;
  padding-right: 16px;
  padding-top: 8px;
  padding-bottom: 8px;
  border-radius: 16px;
}

.toast-text {
  font-size: 13px;
  color: #ffffff;
}
</style>

<script>
import player from '../../js/player.js'
import { searchSongs } from '../../js/musicApi.js'
import router from '@blueos.app.appmanager.router'

export default {
  data: {
    keyword: '',
    songList: [],
    hasSearched: false,
    isLoading: false,
    showToast: false,
    toastMsg: '',
    hotTags: ['周杰伦', '林俊杰', '邓紫棋', '陈奕迅', '薛之谦', '许嵩']
  },

  onInputChange(e) {
    this.keyword = e.value
    if (this.keyword === '') {
      this.hasSearched = false
      this.songList = []
    }
  },

  onSearch() {
    if (!this.keyword.trim()) {
      this.showToastMsg('请输入搜索关键词')
      return
    }
    this.doSearch()
  },

  doSearch() {
    this.isLoading = true
    this.hasSearched = true
    this.songList = []

    searchSongs(this.keyword.trim(), 30).then(res => {
      this.isLoading = false
      if (res && res.result && res.result.songs) {
        this.songList = res.result.songs.map(s => ({
          id: s.id,
          name: s.name,
          artists: s.artists || s.ar,
          album: s.album || s.al
        }))
      }
    }).catch(err => {
      this.isLoading = false
      this.showToastMsg('搜索失败，请检查网络')
    })
  },

  quickSearch(tag) {
    this.keyword = tag
    this.doSearch()
  },

  clearInput() {
    this.keyword = ''
    this.songList = []
    this.hasSearched = false
  },

  getArtistText(song) {
    const artists = song.artists || song.ar || []
    if (Array.isArray(artists)) {
      return artists.map(a => a.name).join(' / ')
    }
    return song.artist || ''
  },

  playSong(index) {
    if (this.songList.length === 0) return
    player.setPlaylist(this.songList, index)
    player.playByIndex(index)
    this.showToastMsg('开始播放')
  },

  playAll() {
    if (this.songList.length === 0) return
    player.setPlaylist(this.songList, 0)
    player.playByIndex(0)
    this.showToastMsg('播放全部')
  },

  addToPlaylist(index, e) {
    if (e) {
      e.stopPropagation()
    }
    const song = this.songList[index]
    if (song) {
      player.addToPlaylist(song)
      this.showToastMsg('已添加到播放列表')
    }
  },

  goBack() {
    router.back()
  },

  showToastMsg(msg) {
    this.toastMsg = msg
    this.showToast = true
    setTimeout(() => {
      this.showToast = false
    }, 1500)
  }
}
</script>
