  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 14px;
  margin-right: 4px;
}

.action-text {
  font-size: 13px;
  color: #cccccc;
}

.list-area {
  flex: 1;
  width: 100%;
}

