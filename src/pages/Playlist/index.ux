.toast {
  position: absolute;
  bottom: 80px;
  left: 0;
  right: 0;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.8);
  padding-left: 16px;
  padding-right: 16px;
  padding-top: 8px;
  padding-bottom: 8px;
  border-radius: 16px;
}

.toast-text {
  font-size: 13px;
  color: #ffffff;
}
</style>

<script>
import player from '../../js/player.js'
import router from '@blueos.app.appmanager.router'

export default {
  data: {
    playlist: [],
    currentIndex: -1,
    isPlaying: false,
    showToast: false,
    toastMsg: ''
  },

  onShow() {
    this.refreshList()
    player.on('playlistChange', this.refreshList.bind(this))
    player.on('songChange', this.refreshList.bind(this))
    player.on('play', this.onPlayStateChange.bind(this))
    player.on('pause', this.onPlayStateChange.bind(this))
  },

  onHide() {
    player.off('playlistChange', this.refreshList.bind(this))
    player.off('songChange', this.refreshList.bind(this))
    player.off('play', this.onPlayStateChange.bind(this))
    player.off('pause', this.onPlayStateChange.bind(this))
  },

  refreshList() {
    this.playlist = player.playlist
    this.currentIndex = player.currentIndex
    this.isPlaying = player.isPlaying
  },

  onPlayStateChange() {
    this.isPlaying = player.isPlaying
  },

  getArtistText(song) {
    const artists = song.artists || song.ar || []
    if (Array.isArray(artists)) {
      return artists.map(a => a.name).join(' / ')
    }
    return song.artist || ''
  },

  playItem(index) {
    player.playByIndex(index)
  },

  playAll() {
    if (player.playlist.length > 0) {
      player.playByIndex(0)
    }
  },

  removeItem(index, e) {
    if (e) {
      e.stopPropagation()
    }
    player.removeFromPlaylist(index)
    this.refreshList()
    this.showToastMsg('已移除')
  },

  clearAll() {
    player.setPlaylist([], -1)
    player.stop()
    this.refreshList()
    this.showToastMsg('已清空播放列表')
  },

  goSearch() {
    router.push({ uri: '/pages/Search' })
  },

  goBack() {
    router.back()
  },

  showToastMsg(msg) {
    this.toastMsg = msg
    this.showToast = true
    setTimeout(() => {
      this.showToast = false
    }, 1500)
  }
}
</script>
