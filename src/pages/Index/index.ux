<template>
  <div class="container">
    <!-- 顶部标题栏 -->
    <div class="header">
      <div class="header-left">
        <text class="app-name">音乐盒</text>
      </div>
      <div class="header-right">
        <div class="mode-btn" onclick="toggleMode">
          <text class="mode-text">{{ playModeText }}</text>
        </div>
      </div>
    </div>

    <!-- 专辑封面区域 -->
    <div class="cover-area">
      <div class="cover-wrapper">
        <image class="cover-img" src="{{ coverUrl }}" if="{{ coverUrl }}" />
        <div class="cover-placeholder" if="{{ !coverUrl }}">
          <text class="placeholder-icon">♪</text>
        </div>
      </div>
    </div>

    <!-- 歌曲信息 -->
    <div class="song-info">
      <text class="song-name text-ellipsis">{{ songName }}</text>
      <text class="song-artist text-ellipsis">{{ songArtist }}</text>
    </div>

    <!-- 进度条 -->
    <div class="progress-area">
      <text class="time-text">{{ currentTimeText }}</text>
      <div class="progress-bar" onclick="onProgressClick">
        <div class="progress-bg"></div>
        <div class="progress-fill" style="width: {{ progressPercent }}%;"></div>
        <div class="progress-dot" style="left: {{ progressPercent }}%;"></div>
      </div>
      <text class="time-text">{{ durationText }}</text>
    </div>

    <!-- 播放控制按钮 -->
    <div class="controls">
      <div class="control-btn" onclick="goPrev">
        <text class="control-icon">⏮</text>
      </div>
      <div class="play-btn" onclick="togglePlay">
        <text class="play-icon">{{ isPlaying ? '⏸' : '▶' }}</text>
      </div>
      <div class="control-btn" onclick="goNext">
        <text class="control-icon">⏭</text>
      </div>
    </div>

    <!-- 底部功能导航 -->
    <div class="bottom-nav">
      <div class="nav-item" onclick="goSearch">
        <text class="nav-icon">🔍</text>
        <text class="nav-label">搜索</text>
      </div>
      <div class="nav-item" onclick="goPlaylist">
        <text class="nav-icon">📋</text>
        <text class="nav-label">列表</text>
      </div>
      <div class="nav-item" onclick="goLyric">
        <text class="nav-icon">📝</text>
        <text class="nav-label">歌词</text>
      </div>
      <div class="nav-item" onclick="goAbout">
        <text class="nav-icon">ℹ</text>
        <text class="nav-label">关于</text>
      </div>
    </div>

    <!-- 提示信息 -->
    <div class="toast" if="{{ showToast }}">
      <text class="toast-text">{{ toastMsg }}</text>
    </div>
  </div>
</template>

<style>
