<template>
  <div class="container">
    <!-- 顶部 -->
    <div class="header">
      <text class="header-title">音乐盒激活</text>
      <div class="header-status">
        <text class="status-text {{ activated ? 'status-ok' : 'status-lock' }}">
          {{ activated ? '✓ 已激活' : '未激活' }}
        </text>
      </div>
    </div>

    <!-- 已激活状态 -->
    <div class="activated-panel" if="{{ activated }}">
      <text class="success-icon">✓</text>
      <text class="success-title">感谢支持！</text>
      <text class="success-sub">音乐盒已成功激活，尽情使用吧</text>
      <div class="enter-btn" onclick="enterApp">
        <text class="enter-btn-text">进入应用</text>
      </div>
    </div>

    <!-- 未激活状态 -->
    <div class="activate-panel" if="{{ !activated }}">
      <!-- 激活码输入 -->
      <div class="form-section">
        <text class="section-label">输入激活码</text>
        <div class="code-input-wrap">
          <input
            class="code-input"
            value="{{ codeInput }}"
            placeholder="请输入激活码"
            onchange="onCodeChange"
          />
        </div>
        <div class="activate-btn" onclick="doActivate">
          <text class="activate-btn-text">立即激活</text>
        </div>
        <text class="error-tip" if="{{ errorMsg }}">{{ errorMsg }}</text>
      </div>

      <!-- 支付说明 -->
      <div class="pay-section">
        <text class="pay-title">获取激活码</text>
        <text class="pay-price">￥ 3.00 / 永久授权</text>

        <div class="pay-qr-wrap">
          <image class="pay-qr" src="{{ qrUrl }}" if="{{ qrUrl }}" />
          <div class="pay-qr-placeholder" if="{{ !qrUrl }}">
            <text class="qr-placeholder-text">微信扫码付款</text>
          </div>
        </div>

        <div class="pay-steps">
          <text class="step-text">1. 微信扫码付款 3 元</text>
          <text class="step-text">2. 付款后保留支付截图</text>
          <text class="step-text">3. 发送支付截图到邮箱</text>
          <text class="step-text email-text">zy291817@outlook.com</text>
          <text class="step-text">4. 查收邮箱获取激活码</text>
        </div>

        <div class="divider"></div>

        <text class="demo-text">演示激活码：</text>
        <text class="demo-code-inline">b33000</text>
        <div class="quick-fill" onclick="fillDemoCode">
          <text class="quick-fill-text">填入演示码</text>
        </div>
      </div>
    </div>

    <!-- Toast -->
    <div class="toast" if="{{ showToast }}">
      <text class="toast-text">{{ toastMsg }}</text>
    </div>
  </div>
</template>

