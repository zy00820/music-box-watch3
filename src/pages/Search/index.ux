<template>
  <div class="container">
    <!-- 搜索栏 -->
    <div class="search-header">
      <div class="search-box">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          value="{{ keyword }}"
          placeholder="搜索歌曲、歌手"
          onchange="onInputChange"
        />
        <div class="clear-btn" if="{{ keyword }}" onclick="clearInput">
          <text class="clear-text">✕</text>
        </div>
      </div>
      <div class="cancel-btn" onclick="goBack">
        <text class="cancel-text">返回</text>
      </div>
    </div>

    <!-- 搜索按钮 -->
    <div class="search-action" if="{{ keyword && !hasSearched }}">
      <div class="search-btn" onclick="onSearch">
        <text class="search-btn-text">搜索「{{ keyword }}」</text>
      </div>
    </div>

    <!-- 搜索结果列表 -->
    <div class="result-list" if="{{ hasSearched && songList.length > 0 }}">
      <list class="list-container">
        <list-item type="song" for="{{ songList }}" onclick="playSong($idx)">
          <div class="song-item">
            <div class="song-index">
              <text class="index-text">{{ $idx + 1 }}</text>
            </div>
            <div class="song-detail">
              <text class="song-name text-ellipsis">{{ $item.name }}</text>
              <text class="song-artist text-ellipsis">{{ getArtistText($item) }}</text>
            </div>
            <div class="song-action" onclick="addToPlaylist($idx, $event)">
              <text class="action-icon">+</text>
            </div>
          </div>
        </list-item>
      </list>
      <div class="play-all" onclick="playAll">
        <text class="play-all-text">▶ 播放全部 ({{ songList.length }})</text>
      </div>
    </div>

    <!-- 搜索中 -->
    <div class="loading-state" if="{{ isLoading }}">
      <text class="loading-text">搜索中...</text>
    </div>

    <!-- 空状态 -->
    <div class="empty-state" if="{{ hasSearched && !isLoading && songList.length === 0 }}">
      <text class="empty-icon">🎵</text>
      <text class="empty-text">未找到相关歌曲</text>
    </div>

    <!-- 默认推荐 -->
    <div class="recommend-area" if="{{ !keyword && !hasSearched }}">
      <text class="recommend-title">热门搜索</text>
      <div class="tags">
        <div class="tag" for="{{ hotTags }}" onclick="quickSearch($item)">
          <text class="tag-text">{{ $item }}</text>
        </div>
      </div>
    </div>

    <!-- Toast -->
    <div class="toast" if="{{ showToast }}">
      <text class="toast-text">{{ toastMsg }}</text>
    </div>
  </div>
</template>

<style>
@import "../../assets/styles/common.css";

.container {
  width: 100%;
  height: 100%;
  background-color: #0a0a0f;
  flex-direction: column;
}

/* 搜索栏 */
.search-header {
  width: 100%;
  flex-direction: row;
  align-items: center;
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 12px;
  padding-bottom: 8px;
}

.search-box {
  flex: 1;
  height: 36px;
  background-color: #1a1a24;
  border-radius: 18px;
  flex-direction: row;
  align-items: center;
  padding-left: 12px;
  padding-right: 12px;
}

.search-icon {
  font-size: 14px;
  margin-right: 6px;
}

.search-input {
  flex: 1;
  height: 36px;
  font-size: 14px;
  color: #ffffff;
  background-color: transparent;
}

.clear-btn {
  width: 20px;
  height: 20px;
  align-items: center;
  justify-content: center;
}

.clear-text {
  font-size: 12px;
  color: #888888;
}

.cancel-btn {
  margin-left: 8px;
  padding-left: 8px;
  padding-right: 4px;
}

.cancel-text {
  font-size: 14px;
  color: #ff4d6f;
}

/* 搜索按钮 */
.search-action {
  width: 100%;
  align-items: center;
  padding: 8px 16px;
}

.search-btn {
  width: 100%;
  height: 40px;
  background-color: #ff4d6f;
  border-radius: 20px;
  align-items: center;
  justify-content: center;
}

.search-btn-text {
  font-size: 14px;
  color: #ffffff;
  font-weight: 500;
}

/* 结果列表 */
.result-list {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.list-container {
  flex: 1;
  width: 100%;
}

.song-item {
  width: 100%;
  height: 60px;
  flex-direction: row;
  align-items: center;
  padding-left: 12px;
  padding-right: 12px;
  border-bottom-width: 1px;
  border-bottom-color: rgba(255, 255, 255, 0.05);
}

.song-index {
  width: 28px;
  align-items: center;
}

.index-text {
  font-size: 13px;
  color: #666666;
}

