.header {
  width: 100%;
  height: 48px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 16px;
  padding-right: 16px;
}

.app-name {
  font-size: 18px;
  color: #ffffff;
  font-weight: 600;
}

.mode-btn {
  width: 58px;
  height: 28px;
  border-radius: 14px;
  background-color: rgba(255, 255, 255, 0.1);
  align-items: center;
  justify-content: center;
}

.mode-text {
  font-size: 12px;
  color: #ff4d6f;
}

/* 专辑封面 */
.cover-area {
  width: 100%;
  align-items: center;
  justify-content: center;
  margin-top: 12px;
  margin-bottom: 16px;
}

.cover-wrapper {
  width: 200px;
  height: 200px;
  border-radius: 100px;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  background-color: #1a1a24;
}

.cover-img {
  width: 180px;
  height: 180px;
  border-radius: 90px;
}

.cover-placeholder {
  width: 180px;
  height: 180px;
  border-radius: 90px;
  align-items: center;
  justify-content: center;
  background-color: #22222e;
}

.placeholder-icon {
  font-size: 72px;
  color: #44444f;
}

/* 歌曲信息 */
.song-info {
  width: 100%;
  align-items: center;
  padding-left: 24px;
  padding-right: 24px;
  margin-bottom: 12px;
}

.song-name {
  font-size: 18px;
  color: #ffffff;
  font-weight: 600;
  text-align: center;
  width: 100%;
  margin-bottom: 4px;
}

.song-artist {
  font-size: 14px;
  color: #999999;
  text-align: center;
  width: 100%;
}

/* 进度条 */
.progress-area {
  width: 100%;
  flex-direction: row;
  align-items: center;
  padding-left: 20px;
  padding-right: 20px;
  margin-bottom: 16px;
}

