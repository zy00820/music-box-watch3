}

.quick-fill-text {
  font-size: 12px;
  color: #ff4d6f;
}

/* ===== Toast ===== */
.toast {
  position: absolute;
  bottom: 80px;
  left: 0;
  right: 0;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.85);
  padding-left: 18px;
  padding-right: 18px;
