</style>

<script>
import auth from '../../js/auth.js'
import router from '@blueos.app.appmanager.router'

export default {
  data: {
    activated: false,
    codeInput: '',
    errorMsg: '',
    showToast: false,
    toastMsg: '',
    qrUrl: ''
  },

  onInit() {
    auth.initAuth()
    this.activated = auth.isActivated()
  },

  onShow() {
    this.activated = auth.isActivated()
  },

  onCodeChange(e) {
    this.codeInput = e.value
    this.errorMsg = ''
  },

  doActivate() {
    const result = auth.activate(this.codeInput)
    if (result.success) {
      this.activated = true
      this.showToastMsg(result.msg)
      setTimeout(() => {
        this.enterApp()
      }, 600)
    } else {
      this.errorMsg = result.msg
      this.showToastMsg(result.msg)
    }
  },

  fillDemoCode() {
    this.codeInput = 'b33000'
    this.errorMsg = ''
    this.showToastMsg('已填入演示激活码')
  },

  enterApp() {
    router.replace({ uri: 'Index' })
  },

  showToastMsg(msg) {
    this.toastMsg = msg
    this.showToast = true
    setTimeout(() => {
      this.showToast = false
    }, 2000)
  }
}
</script>
