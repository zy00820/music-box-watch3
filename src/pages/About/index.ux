<script>
import auth from '../../js/auth.js'
import router from '@blueos.app.appmanager.router'

export default {
  data: {
    showIcon: false,
    version: '1.0.0',
    activated: false,
    showToast: false,
    toastMsg: ''
  },

  onInit() {
    this.activated = auth.isActivated()
    try {
      const manifest = require('../../manifest.json')
      this.version = manifest.versionName || '1.0.0'
      this.showIcon = true
    } catch (e) {}
  },

  onShow() {
    this.activated = auth.isActivated()
  },

  copyEmail() {
    this.showToastMsg('邮箱：zy291817@outlook.com')
  },

  copyGroup() {
    this.showToastMsg('QQ群：586352356')
  },

  goBack() {
    router.back()
  },

  showToastMsg(msg) {
    this.toastMsg = msg
    this.showToast = true
    setTimeout(() => { this.showToast = false }, 2000)
  }
}
</script>
