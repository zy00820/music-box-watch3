  font-size: 13px;
  color: #666666;
}

.song-detail {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  margin-left: 8px;
  margin-right: 8px;
}

.song-name {
  font-size: 14px;
  color: #ffffff;
  margin-bottom: 2px;
}

.name-active {
  color: #ff4d6f;
}

