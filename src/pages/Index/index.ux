  font-size: 28px;
  color: #ffffff;
}

/* 底部导航 */

.bottom-nav {
  margin-top: auto;
  width: 100%;
  height: 64px;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  background-color: rgba(255, 255, 255, 0.03);
  border-top-width: 1px;
  border-top-color: rgba(255, 255, 255, 0.05);
}

.nav-item {
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.nav-icon {
  font-size: 20px;
  margin-bottom: 2px;
}

.nav-label {
  font-size: 10px;
  color: #888888;
}

/* Toast */
.toast {
  position: absolute;
  bottom: 80px;
  left: 0;
  right: 0;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.8);
  padding-left: 16px;
  padding-right: 16px;
  padding-top: 8px;
  padding-bottom: 8px;
  border-radius: 16px;
}

.toast-text {
  font-size: 13px;
  color: #ffffff;
}
</style>

<script>
import player from '../../js/player.js'
import { formatTime, getNewSongs } from '../../js/musicApi.js'
import auth from '../../js/auth.js'
import router from '@blueos.app.appmanager.router'

export default {
  data: {
    songName: '未播放',
    songArtist: '点击搜索开始',
    coverUrl: '',
    isPlaying: false,
    currentTime: 0,
    duration: 0,
    currentTimeText: '00:00',
    durationText: '00:00',
    progressPercent: 0,
    playMode: 'list',
    playModeText: '列表',
    showToast: false,
    toastMsg: ''
  },

  onInit() {
    auth.initAuth()
    if (!auth.isActivated()) {
      router.replace({ uri: '/pages/Activate' })
      return
    }
    this.bindPlayerEvents()
  },

  onShow() {
    // 页面显示时同步状态
    if (player.currentSong) {
      this.syncSongInfo(player.currentSong)
    }
    this.isPlaying = player.isPlaying
    this.playMode = player.playMode
    this.updateModeText()
  },

  /**
   * 绑定播放器事件
   */
  bindPlayerEvents() {
    player.on('songChange', (song) => {
      this.syncSongInfo(song)
    })

    player.on('play', () => {
      this.isPlaying = true
    })

    player.on('pause', () => {
      this.isPlaying = false
    })

    player.on('progress', (data) => {
      this.currentTime = data.currentTime
      this.duration = data.duration
      this.currentTimeText = formatTime(data.currentTime)
      this.durationText = formatTime(data.duration)
      if (data.duration > 0) {
        this.progressPercent = (data.currentTime / data.duration) * 100
      }
    })

    player.on('modeChange', (mode) => {
      this.playMode = mode
      this.updateModeText()
    })

    player.on('error', (err) => {
      this.showToastMsg(err.msg || '播放出错')
    })
  },

  /**
   * 同步歌曲信息到UI
   */
  syncSongInfo(song) {
    if (!song) {
      this.songName = '未播放'
      this.songArtist = '点击搜索开始'
      this.coverUrl = ''
      return
    }
    this.songName = song.name || '未知歌曲'
    const artists = song.artists || song.ar || []
    if (Array.isArray(artists)) {
      this.songArtist = artists.map(a => a.name).join(' / ')
    } else {
      this.songArtist = song.artist || ''
    }
    // 专辑封面
    const album = song.album || song.al || {}
    this.coverUrl = album.picUrl || song.picUrl || album.img80x80 || ''
  },

  /**
   * 更新播放模式文字
   */
  updateModeText() {
    const modeMap = {
      list: '列表',
      single: '单曲',
      random: '随机'
    }
    this.playModeText = modeMap[this.playMode] || '列表'
  },

  /**
   * 切换播放/暂停
   */
  togglePlay() {
    if (player.playlist.length === 0) {
      this.showToastMsg('请先搜索或添加歌曲')
      return
    }
    player.togglePlay()
  },

  /**
   * 上一首
   */
  goPrev() {
    if (player.playlist.length === 0) {
      this.showToastMsg('播放列表为空')
      return
    }
    player.prev()
  },

  /**
   * 下一首
   */
  goNext() {
    if (player.playlist.length === 0) {
      this.showToastMsg('播放列表为空')
      return
    }
    player.next()
  },

  /**
   * 切换播放模式
   */
  toggleMode() {
    const mode = player.togglePlayMode()
    this.playMode = mode
    this.updateModeText()
    const modeText = { list: '列表循环', single: '单曲循环', random: '随机播放' }
    this.showToastMsg(modeText[mode])
  },

  /**
   * 进度条点击跳转
   */
  onProgressClick(e) {
    if (this.duration <= 0) return
    // 计算点击位置比例
    const percent = (e.nativeEvent.pageX - e.target.offsetLeft) / e.target.offsetWidth
    const targetTime = percent * this.duration
    player.seek(targetTime)
  },

  /**
   * 跳转搜索页
   */
  goSearch() {
    router.push({ uri: '/pages/Search' })
  },

  /**
   * 跳转播放列表页
   */
  goPlaylist() {
    router.push({ uri: '/pages/Playlist' })
  },

  /**
   * 跳转歌词页
   */
  goLyric() {
    router.push({ uri: '/pages/Lyric' })
  },

  /**
   * 加载热门歌曲
   */
  loadHotSongs() {
    this.showToastMsg('正在加载热门歌曲...')
    getNewSongs(0).then(res => {
      if (res && res.data && res.data.length > 0) {
        const songs = res.data.map(item => ({
          id: item.id,
          name: item.name,
          artists: item.artists,
          album: item.album
        }))
        player.setPlaylist(songs, 0)
        player.playByIndex(0)
        this.showToastMsg('已加载热门歌曲')
      } else {
        this.showToastMsg('加载失败，请稍后重试')
      }
    }).catch(err => {
      this.showToastMsg('网络错误')
    })
  },

  /**
   * 显示提示信息
   */
  showToastMsg(msg) {
    this.toastMsg = msg
    this.showToast = true
    setTimeout(() => {
      this.showToast = false
    }, 2000)
  }
}
</script>
